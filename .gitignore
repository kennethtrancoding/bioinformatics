# Anchored to repo root: an unanchored `lib/`/`lib64/` (the standard Python
# template) matches at any depth and was silently excluding the real
# workflow/lib/ package (jobs.py, utils.py, s3_storage.py, ...) from git.
/helpers/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage

# Conda
.conda/
envs/*/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.localized
Thumbs.db

# Project-specific
.bvbrc_token
results/*/
data/raw_fastq/
# The whole of config/ is local now: config.yaml, samples.csv, checksums.json
# and api_endpoints.json were purged from history, and the per-job runtime state
# under config/jobs/<JOB_ID>/ (sample manifests, checksums, endpoint overrides,
# BV-BRC tokens) was never meant to be tracked in the first place. Ignoring the
# directory rather than its contents keeps any of it from being re-added.
config/
logs/
*.txt.gz
*.fastq.gz
*.fasta.gz

# Sensitive
*.credentials
*.env
.env.local

# Test/scratch files
scratch_*.py
*_test.py

# Local AMR BLAST database: a build artifact, rebuilt on demand by
# workflow/scripts/build_amr_blastdb.py and baked fresh into the Docker image.
resources/blastdb/
.codegraphy/*
