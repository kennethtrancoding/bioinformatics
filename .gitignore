# Anchored to repo root: an unanchored `lib/`/`lib64/` (the standard Python
# template) matches at any depth and was silently excluding the real
# workflow/lib/ package (jobs.py, utils.py, s3_storage.py, ...) from git.
/helpers/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage

# Conda
.conda/
envs/*/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.localized
Thumbs.db

# Project-specific
.bvbrc_token
results/*/
data/raw_fastq/
# config/ is local apart from config.yaml: samples.csv, checksums.json and
# api_endpoints.json were purged from history, and the per-job runtime state
# under config/jobs/<JOB_ID>/ (sample manifests, checksums, endpoint overrides,
# BV-BRC tokens) was never meant to be tracked in the first place.
#
# config.yaml is the exception because the image cannot be built without it --
# the Dockerfile COPYs it so Snakemake can parse it as configfile: at DAG time.
# It carries pipeline settings only, no credentials.
#
# The contents are excluded rather than the directory itself, because git cannot
# re-include a file whose parent directory is excluded: with `config/` here, the
# negation below would silently do nothing and the build would break again.
config/*
!config/config.yaml
logs/
*.txt.gz
*.fastq.gz
*.fasta.gz

# Sensitive
*.credentials
*.env
.env.local

# Test/scratch files
scratch_*.py
*_test.py

# Local AMR BLAST database: a build artifact, rebuilt on demand by
# workflow/scripts/build_amr_blastdb.py and baked fresh into the Docker image.
resources/blastdb/
.codegraphy/*
